{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Worktree einrichten",
      "command": "pnpm install --frozen-lockfile --strict-peer-dependencies",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Extension testen",
      "command": "pnpm test",
      "icon": "test"
    },
    {
      "name": "Chrome-Build erstellen",
      "command": "pnpm build",
      "icon": "build"
    }
  ]
}
